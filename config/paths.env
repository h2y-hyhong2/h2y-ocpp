# ========================================================
# ELVIS-CSMS 스토리지 및 네트워크 포트 설정 파일
# ========================================================
ELVIS_DATA_DIR=D:\elvis-lite\data
ELVIS_LOG_DIR=D:\elvis-lite\logs

# 네트워크 미들웨어 포트 (기본값: ELVIS-Lite 충돌 방지 전용 포트)
ELVIS_MYSQL_PORT=13306
ELVIS_KAFKA_PORT=19092
ELVIS_CLICKHOUSE_HTTP_PORT=8123
ELVIS_CLICKHOUSE_TCP_PORT=9000

# 코어 백엔드 포트 (엔터프라이즈 표준 9080 대역)
ELVIS_WS_PORT=9080
ELVIS_SYNC_PORT=9081
ELVIS_API_PORT=9082
ELVIS_DATA_CH_PORT=9083
ELVIS_TESTER_PORT=9085
